#!/usr/bin/env bash
# HOOK_VERSION=3
# Traceability gate (standing rule 4): every commit message names the IDs
# it implements, so `git log` stays a map from code to decisions.
#
# This is the git-native layer. It runs from git itself and depends on
# nothing but bash and grep — no Claude, no dev-procedure checkout, no
# network. That independence is deliberate (Kenny, 2026-09-09): the
# enforcement has to survive any change of tooling or subscription.
#
# Optional per project: ship .githooks/guarded-paths.sh printing the
# staged paths the code rules apply to, and a commit touching none of
# them passes untouched — that is how a repository holding documents
# beside code keeps its document commits free. Without that file every
# commit is held to the rule, which is the default.
#
# Two ID shapes are accepted. The house scheme is a kind word, an
# optional domain and a number: [feat-storage-12], [arch-7, gap-5]. The
# older letter-plus-digit shape stays valid because history is not
# rewritten and 1068 existing commits carry it.
set -u

msg_file="${1:?usage: commit-msg <file>}"

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$root" ] && [ -x "$root/.githooks/guarded-paths.sh" ]; then
  guarded="$("$root/.githooks/guarded-paths.sh" "$root" 2>/dev/null || true)"
  if [ -z "$guarded" ]; then
    exit 0
  fi
fi

# The ID-scheme gate rides here rather than in pre-commit, so it travels
# with this file through sync-hooks.sh instead of needing a per-project
# edit. It reads the staged diff, which is already written at this point.
if [ -n "$root" ]; then
  if [ -x "$root/.githooks/check-ids.sh" ]; then
    "$root/.githooks/check-ids.sh" || exit 1
  else
    # Absent means a broken install, not a project opting out: this file
    # and that one are copied together by sync-hooks.sh. Skipping in
    # silence is the fail-open rule 12 forbids, and it happened — eleven
    # commits announced the gate while `git commit -am` had left the new
    # file untracked, so it was installed nowhere and said nothing.
    echo "warning: .githooks/check-ids.sh is missing; the ID gate did not run." >&2
    echo "         Re-run dev-procedure's hooks/sync-hooks.sh for this project." >&2
  fi
fi

if ! grep -qE '\[(meta|[A-Za-z]{1,4}[0-9][^]]*|[a-z]{3,}(-[a-z0-9]+)*-[0-9]+[^]]*)\]' "$msg_file"; then
  {
    echo "COMMIT BLOCKED — message lacks feature/milestone IDs (standing rule 4)."
    if [ -n "${guarded:-}" ]; then
      echo "This commit touches guarded paths:"
      printf '  %s\n' $guarded
    fi
    echo "Add the IDs this commit implements, e.g.: feat(sync): groups [feat-storage-12, arch-7]"
    echo "Pure infrastructure commits use [meta], which stands alone —"
    echo "[meta, fix-1] is refused; write [fix-1] when the commit does the work."
  } >&2
  exit 1
fi
